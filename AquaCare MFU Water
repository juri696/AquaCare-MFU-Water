<title>AquaCare MFU</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;600;700&family=Noto+Serif+Thai:wght@600;700&display=swap">
<style>
:root{--bg:#F6F3F1;--card:#fff;--ink:#2A1517;--mute:#6B5558;--line:#E6DCD9;--red:#9B1B30;--rink:#fff;--gold:#C9A227;--gsoft:#FBF0CC;--gink:#6B4E00;--ok:#1E7B46;--bad:#B3122E;--head:#7E1526;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#170E10;--card:#241719;--ink:#F4EAE6;--mute:#BFA9AB;--line:#3A2A2D;--red:#E0566B;--rink:#1A0A0D;--gold:#E3B341;--gsoft:#3A2F10;--gink:#F0CF73;--ok:#5BCB8A;--bad:#FF7A8E;--head:#4A1019}}
:root[data-theme="dark"]{--bg:#170E10;--card:#241719;--ink:#F4EAE6;--mute:#BFA9AB;--line:#3A2A2D;--red:#E0566B;--rink:#1A0A0D;--gold:#E3B341;--gsoft:#3A2F10;--gink:#F0CF73;--ok:#5BCB8A;--bad:#FF7A8E;--head:#4A1019}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 "Noto Sans Thai",system-ui,sans-serif}
header{background:var(--head);color:#FBEFD0;border-bottom:4px solid var(--gold);padding:18px 20px 14px}
.in{max-width:1200px;margin:0 auto}
.hr{display:flex;justify-content:space-between;align-items:center;gap:12px}
h1{margin:0;font:700 24px "Noto Serif Thai",Georgia,serif;letter-spacing:.2px}
header p{margin:2px 0 0;font-size:14px;opacity:.9}
.tag{background:var(--gold);color:#3A2A00;font-size:12px;font-weight:700;padding:3px 10px;border-radius:99px}
.shell{max-width:1200px;margin:0 auto}main{padding:16px 16px 100px;min-width:0}.g{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}.g.w{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}.k b{display:block;font:700 26px "Noto Serif Thai",Georgia,serif}.k small{color:var(--mute);font-size:13px}.demo{background:var(--gsoft);color:var(--gink);font-size:12px;font-weight:700;padding:2px 8px;border-radius:99px;white-space:nowrap}.row2{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:10px 0;border-top:1px solid var(--line)}
section{display:flex;flex-direction:column;gap:12px}
section[hidden]{display:none}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px}
.card h2{margin:0 0 6px;font:700 17px "Noto Serif Thai",Georgia,serif}
.big{font:700 22px "Noto Serif Thai",Georgia,serif;margin:2px 0}
.mute{color:var(--mute);font-size:14px}
.row{display:flex;gap:10px}
.m{flex:1;min-width:0}
.m small{display:block;color:var(--mute);font-size:12px}
.m b{font:700 22px "Noto Serif Thai",Georgia,serif}
.st{font-weight:700;font-size:14px}
.ok{color:var(--ok)}.warn{color:var(--gink)}.bad{color:var(--bad)}
.pt{display:flex;flex-direction:column;gap:10px}
.top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.badge{padding:3px 10px;border-radius:99px;font-size:13px;font-weight:700;background:var(--gsoft);color:var(--gink)}
.badge.bad{background:var(--bad);color:var(--card)}
.alert{border-left:6px solid var(--red)}
.alert.done{border-left-color:var(--line);opacity:.92}
.alert.open{border-left-color:var(--bad)}
button,select,input{font:inherit;color:inherit}
.btn{min-height:48px;padding:0 16px;border-radius:12px;border:2px solid var(--red);background:var(--red);color:var(--rink);font-weight:700;cursor:pointer}
.btn.alt{background:transparent;color:var(--red)}
.btns{display:flex;gap:8px;flex-wrap:wrap}.btns .btn{flex:1}
.chips{display:flex;gap:8px}
.chip{flex:1;min-height:44px;border-radius:99px;border:2px solid var(--line);background:var(--card);font-weight:600;cursor:pointer}
.chip[aria-pressed="true"]{border-color:var(--gold);background:var(--gsoft);color:var(--gink)}
label{display:block;font-size:14px;color:var(--mute);margin-top:8px}
input,select{width:100%;min-height:46px;border-radius:10px;border:1px solid var(--line);background:var(--bg);padding:0 12px}
nav{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-top:1px solid var(--line);display:flex;overflow-x:auto;padding-bottom:env(safe-area-inset-bottom,0px)}
nav button{flex:1 0 92px;min-height:60px;border:0;background:none;font-size:14px;color:var(--mute);cursor:pointer;position:relative}
nav button[aria-current="page"]{color:var(--red);font-weight:700;box-shadow:inset 0 4px 0 var(--gold)}
.dot{position:absolute;top:8px;margin-left:6px;background:var(--bad);color:var(--card);border-radius:99px;font-size:11px;min-width:18px;padding:0 5px}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
svg{display:block;width:100%;height:auto}
.ln{fill:none;stroke:var(--red);stroke-width:2.5}.fc{fill:none;stroke:var(--gold);stroke-width:3;stroke-dasharray:6 5}.th{stroke:var(--bad);stroke-dasharray:4 4;stroke-width:1.5}
.sv{fill:var(--mute);font-size:11px}
@media(min-width:900px){.shell{display:grid;grid-template-columns:240px 1fr}nav{grid-column:1;grid-row:1;position:sticky;top:16px;bottom:auto;align-self:start;flex-direction:column;overflow:visible;margin:16px 0 0 16px;border:1px solid var(--line);border-radius:14px;padding:8px}main{grid-column:2;grid-row:1;padding-bottom:32px}nav button{flex:none;text-align:left;border-radius:10px;padding:0 14px;min-height:48px}nav button[aria-current="page"]{box-shadow:inset 4px 0 0 var(--gold);background:var(--gsoft)}}
</style>
</head>
<body>
<header><div class="in"><div class="hr"><h1>AquaCare MFU</h1><div style="display:flex;gap:8px;align-items:center"><span class="tag" data-i="tag">โหมดจำลอง</span><select id="lang" aria-label="ภาษา / Language" style="width:auto;min-height:36px;background:var(--card);color:var(--ink)"><option value="th">ไทย</option><option value="en">English</option><option value="my">မြန်မာ</option><option value="zh">中文</option><option value="ko">한국어</option><option value="ja">日本語</option><option value="id">Bahasa Indonesia</option><option value="km">ខ្មែរ</option></select></div></div><p data-i="tagline">AI เฝ้าระวังคุณภาพน้ำในหอพักนักศึกษาและพื้นที่ส่วนกลาง มหาวิทยาลัยแม่ฟ้าหลวง</p></div></header>
<div class="shell"><main>
<section id="p-home"></section><section id="p-list" hidden></section>
<section id="p-alerts" hidden></section>
<section id="p-fc" hidden></section>
<section id="p-lab" hidden>
<div class="card"><h2 data-i="labCtl">ควบคุมการจำลอง</h2><div class="btns"><button class="btn alt" data-a="play" id="playBtn" data-i="pause">หยุดชั่วคราว</button><button class="btn alt" data-a="reset" data-i="reset">ล้างข้อมูลและเริ่มใหม่</button></div></div>
<div class="card"><h2 data-i="injT">จำลองน้ำขุ่นผิดปกติ</h2><div id="injBox"></div><div class="btns" style="margin-top:12px"><button class="btn" data-a="inj" data-i="injB">เริ่มเหตุการณ์น้ำขุ่น</button></div></div>
<div class="card"><h2 data-i="manT">ใส่ค่าที่วัดเอง</h2><div id="mpBox"></div><label for="mt"><span data-i="turb">ความขุ่น</span> (NTU)</label><input id="mt" type="number" step="0.1" value="2.0" inputmode="decimal"><label for="mph">pH</label><input id="mph" type="number" step="0.1" value="7.2" inputmode="decimal"><label for="mtemp" data-i="temp">อุณหภูมิ (°C)</label><input id="mtemp" type="number" step="0.1" value="26" inputmode="decimal"><div class="btns" style="margin-top:12px"><button class="btn" data-a="add" data-i="addB">เพิ่มค่าและตรวจสอบ</button></div><p id="msg" class="mute" role="status" aria-live="polite" style="margin:8px 0 0"></p></div>
</section>
</main>
<nav aria-label="เมนูหลัก">
<button data-a="tab" data-v="home" aria-current="page"><span data-i="home">ภาพรวม</span></button>
<button data-a="tab" data-v="dorm"><span data-i="dorm">หอพักนักศึกษา</span></button>
<button data-a="tab" data-v="food"><span data-i="food">โรงอาหาร</span></button>
<button data-a="tab" data-v="central"><span data-i="central">ระบบน้ำส่วนกลาง</span></button>
<button data-a="tab" data-v="fc"><span data-i="fc">คาดการณ์ด้วย AI</span></button>
<button data-a="tab" data-v="alerts"><span data-i="alerts">แจ้งเตือน</span><span class="dot" id="dot" hidden></span></button>
<button data-a="tab" data-v="lab"><span data-i="lab">ตั้งค่าและทดลอง</span></button>
</nav></div>
<script>
const TH=5;
const PTS=[];
const S={play:true,tick:0,sel:'B',tab:'home',lang:'th',listFor:'',data:{},open:{},calm:{},boost:{},mute:{},z:{},alerts:[]};
const CATS={dorm:{get n(){return t('cDorm')}},food:{get n(){return t('cFood')}},central:{get n(){return t('cCentral')}}};
const LBL={get ok(){return t('ok')},get warn(){return t('warn')},get bad(){return t('bad')}};
const R=[];const add=(c,g,ns)=>ns.forEach(n=>R.push({c,g,n}));
add('dorm','กลุ่ม F',[1,2,3,4,5,6].map(i=>'F'+i));
add('dorm','กลุ่มลำดวน',[1,2,3,4,5,6,7].map(i=>'ลำดวน '+i));
add('dorm','กลุ่มสักทอง',[1,2,3].map(i=>'สักทอง '+i));
add('dorm','หอพักชื่อเฉพาะ',['หอพักประเสริฐฯ','หอพักบุญทรงฯ','หอพัก พล.ต.อ.เภาฯ','หอพักนักศึกษานานาชาติ']);
add('food','ศูนย์อาหารและจุดจำหน่าย',['ศูนย์อาหาร D1','ศูนย์อาหาร E1','ศูนย์อาหาร E2','ศูนย์อาหาร C5','พื้นที่จำหน่ายอาหารและเครื่องดื่ม S2','ครัวลำดวน','ครัวมายมัม','จุดจำหน่ายอาหารบริเวณสระว่ายน้ำ','ศูนย์อาหาร E-Park','ห้องอาหารโรงพยาบาลมหาวิทยาลัยแม่ฟ้าหลวง','เรือนริมน้ำ']);
R.forEach((x,i)=>{if(x.c==='dorm')[1,2,3,4].forEach(f=>PTS.push({id:'d'+i+'-'+f,loc:x.n,fl:f,get n(){return dn(this.loc)+' · '+t('rest')+' '+this.fl}}));else if(x.c==='food')PTS.push({id:'f'+i,loc:x.n,fl:0,get n(){return dn(this.loc)}});});
const $=id=>document.getElementById(id);
const rnd=()=>Math.random()+Math.random()+Math.random()-1.5;
const LOC={th:'th-TH',en:'en-GB',my:'my-MM',zh:'zh-CN',ko:'ko-KR',ja:'ja-JP',id:'id-ID',km:'km-KH'};const lc=()=>LOC[S.lang]+'-u-nu-latn';const clock=x=>new Date(x).toLocaleTimeString(lc(),{hour:'2-digit',minute:'2-digit',second:'2-digit'});
function save(){try{localStorage.setItem('aquacare.alerts',JSON.stringify(S.alerts.slice(0,50)))}catch(e){}}
function load(){try{return JSON.parse(localStorage.getItem('aquacare.alerts')||'[]')}catch(e){return[]}}
function gen(id,k){
  const h=[...id].reduce((s,c)=>s+c.charCodeAt(0),0),o=1.8+(h%5)/10;
  let turb=o+0.25*Math.sin(k/9+h)+rnd()*0.12,ph=7.2+rnd()*0.05+(h%3)*-0.05,tp=26+0.4*Math.sin(k/20)+rnd()*0.1;
  if(S.boost[id]>0){turb+=1.6+(10-S.boost[id])*0.2;S.boost[id]--;}
  return{t:Date.now(),turb:Math.max(0,turb),ph,tp};
}
function stat(a){const m=a.reduce((s,v)=>s+v,0)/a.length;return[m,Math.sqrt(a.reduce((s,v)=>s+(v-m)**2,0)/a.length)];}
function detect(id){
  const a=S.data[id];if(a.length<20)return;
  const cur=a[a.length-1],w=a.slice(-31,-1);
  const[mt,st]=stat(w.map(r=>r.turb)),[mp,sp]=stat(w.map(r=>r.ph));
  const zt=(cur.turb-mt)/Math.max(st,.1),zp=(cur.ph-mp)/Math.max(sp,.05);
  const z=Math.max(Math.abs(zt),Math.abs(zp));S.z[id]=z;
  if(S.open[id]){if(z<2){S.calm[id]=(S.calm[id]||0)+1;if(S.calm[id]>=3){S.open[id]=null;S.calm[id]=0;}}else S.calm[id]=0;return;}
  if(z>=4&&S.tick>=(S.mute[id]||0)){
    const isT=Math.abs(zt)>=Math.abs(zp);
    const al={uid:Date.now()+id,id,t:Date.now(),kind:isT?'turb':'ph',from:isT?mt:mp,to:isT?cur.turb:cur.ph,score:Math.min(1,z/8),fixed:cur.turb>TH,status:'open'};
    S.alerts.unshift(al);S.open[id]=al.uid;save();
  }
}
function addReading(id,r){const a=S.data[id];a.push(r);if(a.length>150)a.shift();detect(id);}
function fit(v){const n=v.length;let sx=0,sy=0,sxy=0,sxx=0;v.forEach((y,x)=>{sx+=x;sy+=y;sxy+=x*y;sxx+=x*x;});const m=(n*sxy-sx*sy)/(n*sxx-sx*sx||1);return{m,b:(sy-m*sx)/n};}
function forecast(id){
  const v=S.data[id].map(r=>r.turb),seg=v.slice(-20),f=fit(seg),n=seg.length,pred=[];
  for(let h=1;h<=12;h++)pred.push(Math.max(0,f.b+f.m*(n-1+h)));
  let eta=pred.findIndex(p=>p>TH);
  let mae=null;if(v.length>=32){let e=0;for(let i=v.length-10;i<v.length;i++){const g=fit(v.slice(i-20,i));e+=Math.abs(v[i]-(g.b+g.m*20));}mae=e/10;}
  return{pred,slope:f.m,eta:eta<0?null:eta+1,mae};
}
function status(id){
  if(S.open[id])return{c:'bad',t:'วิกฤต'};
  if((S.z[id]||0)>=3.2||forecast(id).eta)return{c:'warn',t:'เฝ้าระวัง'};
  return{c:'ok',t:'ปกติ'};
}
function chart(vals,pred){
  const W=340,H=170,p=8,n=vals.length,tot=n-1+pred.length;
  const mx=Math.max(TH+1,...vals,...pred)*1.05;
  const X=i=>p+i*(W-2*p)/tot,Y=v=>H-20-(v/mx)*(H-34);
  const h=vals.map((v,i)=>X(i).toFixed(1)+','+Y(v).toFixed(1)).join(' ');
  const f=[vals[n-1],...pred].map((v,i)=>X(n-1+i).toFixed(1)+','+Y(v).toFixed(1)).join(' ');
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${t('turb')}"><line class="th" x1="0" x2="${W}" y1="${Y(TH)}" y2="${Y(TH)}"/><text class="sv" x="4" y="${Y(TH)-5}">${TH} NTU</text><polyline class="ln" points="${h}"/><polyline class="fc" points="${f}"/></svg>`;
}
const K='home dorm food central fc alerts lab ok warn bad kPlaces kOff kLast cDorm cFood cCentral detail demo recent all trend search tag tagline rest loc'.split(' ');
const I={
th:'ภาพรวม|หอพักนักศึกษา|โรงอาหาร|ระบบน้ำส่วนกลาง|คาดการณ์ด้วย AI|แจ้งเตือน|ตั้งค่าและทดลอง|ปกติ|เฝ้าระวัง|วิกฤต|พื้นที่ที่มีจุดตรวจวัด|เซนเซอร์ออฟไลน์/ล้าสมัย|ข้อมูลล่าสุด|หอพักนักศึกษา|โรงอาหารและจุดจำหน่ายอาหาร|ระบบน้ำส่วนกลางและพื้นที่อื่น ๆ|ดูรายละเอียด|ข้อมูลจำลอง|การแจ้งเตือนล่าสุด|ดูทั้งหมด|แนวโน้มความขุ่น (ย่อ)|ค้นหา|โหมดจำลอง|AI เฝ้าระวังคุณภาพน้ำในหอพักนักศึกษาและพื้นที่ส่วนกลาง มหาวิทยาลัยแม่ฟ้าหลวง|ห้องน้ำชั้น|สถานที่',
en:'Overview|Dormitories|Canteens|Central water system|AI forecast|Alerts|Settings & demo|Normal|Watch|Critical|Areas with monitoring points|Sensors offline/stale|Latest data|Student dormitories|Canteens & food outlets|Central water system & other areas|View details|Simulated data|Latest alerts|View all|Turbidity trend (mini)|Search|Demo mode|AI water quality monitoring for dormitories and shared areas, Mae Fah Luang University|Restroom floor|Location',
