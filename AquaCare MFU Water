 return NK[n]?t(NK[n]):n;}
const stale=p=>Date.now()-S.data[p.id].slice(-1)[0].t>10000;
function locs(c){return R.filter(x=>x.c===c).map(x=>{const ps=PTS.filter(p=>p.loc===x.n);return{...x,ps,st:ps.length?(ps.some(p=>status(p.id).c==='bad')?'bad':ps.some(p=>status(p.id).c==='warn')?'warn':'ok'):null};});}
function spark(v){const mx=Math.max(...v)*1.1,n=v.length;return `<svg viewBox="0 0 300 60" role="img" aria-label="${t('trend')}"><polyline class="ln" points="${v.map((y,i)=>(i*300/(n-1)).toFixed(1)+','+(58-y/mx*54).toFixed(1)).join(' ')}"/></svg>`;}
function homeHTML(){
  const d=locs('dorm'),f=locs('food'),w=[...d,...f].filter(x=>x.ps.length),dw=d.filter(x=>x.ps.length),fw=f.filter(x=>x.ps.length);
  const cnt=s=>w.filter(x=>x.st===s).length,off=PTS.filter(stale).length,last=Math.max(...PTS.map(p=>S.data[p.id].slice(-1)[0].t));
  const k=(l,v,c)=>`<div class="card k"><small>${l}</small><b class="${c||''}">${v}</b></div>`;
  const m=(l,v)=>`<div class="row2"><span class="mute">${l}</span><b>${v}</b></div>`;
  const cat=(c,body)=>`<div class="card"><h2>${CATS[c].n}</h2>${body}<div class="btns" style="margin-top:12px"><button class="btn alt" data-a="tab" data-v="${c}">${t('detail')}</button></div></div>`;
  const recent=S.alerts.slice(0,3).map(a=>`<div class="row2"><span>${a.kind==='turb'?t('turb'):'pH'} · ${PTS.find(p=>p.id===a.id).n}<br><span class="mute">${clock(a.t)}</span></span><span class="badge ${a.status==='open'?'bad':''}">${a.status==='open'?t('aOpen'):a.status==='confirmed'?t('aReal'):t('aFalse')}</span></div>`).join('')||'<p class="mute" style="margin:6px 0 0">'+t('noAl')+'</p>';
  return `<div class="card" style="border-left:6px solid var(--gold)"><span class="demo">${t('demo')}</span> <span class="mute">${t('note')}</span></div>
<div class="g">${k(t('kPlaces'),w.length)}${k(t('ok'),cnt('ok'),'ok')}${k(t('warn'),cnt('warn'),'warn')}${k(t('bad'),cnt('bad'),'bad')}${k(t('kOff'),off)}${k(t('kLast'),clock(last))}</div>
<div class="g w">${cat('dorm',m(t('rDorm'),d.length)+m(t('hasPts'),dw.length)+m(t('ok'),dw.filter(x=>x.st==='ok').length)+m(t('warn'),dw.filter(x=>x.st!=='ok').length))}${cat('food',m(t('rFood'),f.length)+m(t('onl'),fw.filter(x=>x.ps.some(p=>!stale(p))).length)+m(t('chk'),fw.filter(x=>x.st!=='ok').length))}${cat('central','<p class="mute" style="margin:6px 0 0">'+t('cNone')+'</p>')}</div>
<div class="g w"><div class="card"><div class="top"><h2 style="margin:0">${t('recent')}</h2><button class="chip" style="flex:none;padding:0 14px" data-a="tab" data-v="alerts">${t('all')}</button></div>${recent}</div><div class="card"><h2>${t('trend')}</h2>${spark(S.data[PTS[0].id].map(r=>r.turb).slice(-40))}<p class="mute" style="margin:6px 0 0">${PTS[0].n} · ${t('demo')}</p></div></div>`;
}
function listShell(c){return `<div class="card"><h2>${CATS[c].n}</h2><p class="mute" style="margin:0">${c==='central'?t('noReg'):t('listNote')}</p><label for="q">${t('search')}</label><input id="q" type="search" placeholder="${t('phName')}"></div><div id="rows" class="g w"></div>`;}
function rowsHTML(c,q){
  const l=locs(c).filter(x=>(dn(x.n)+gn(x.g)).toLowerCase().includes(q.trim().toLowerCase()));
  if(!l.length)return `<div class="card"><b>${c==='central'?t('noPt'):t('noItem')}</b></div>`;
  return l.map(x=>{const det=c==='food'?'':x.ps.map(p=>`<div class="row2"><span>${p.n}</span><span class="st ${status(p.id).c}">${LBL[status(p.id).c]}</span></div>`).join('');return `<div class="card"><div class="top"><b>${dn(x.n)}</b>${x.st?`<span class="st ${x.st}">${LBL[x.st]}</span>`:''}</div><div class="mute">${gn(x.g)} · ${t('sOn')} ${x.ps.filter(p=>!stale(p)).length}/${x.ps.length}</div><span class="demo">${t('demo')}</span>${det}</div>`;}).join('');
}
function alertsHTML(){
  const c=S.alerts.filter(a=>a.status==='confirmed').length,f=S.alerts.filter(a=>a.status==='false').length;
  const prec=c+f?Math.round(100*c/(c+f))+'%':t('noData');
  let h=`<div class="card"><h2>${t('sum')}</h2><div class="row"><div class="m"><small>${t('total')}</small><b>${S.alerts.length}</b></div><div class="m"><small>${t('aReal')}</small><b>${c}</b></div><div class="m"><small>${t('aFalse')}</small><b>${f}</b></div></div><p class="mute" style="margin:8px 0 0">${t('prec')}: <b>${prec}</b></p></div>`;
  if(!S.alerts.length)h+=`<div class="card"><b>${t('noAl')}</b></div>`;
  S.alerts.forEach(a=>{
    const pn=PTS.find(p=>p.id===a.id).n,k=a.kind==='turb'?t('turb'):'pH',u=a.kind==='turb'?' NTU':'';
    const res=a.status==='confirmed'?`<span class="badge">${t('aReal')}</span>`:a.status==='false'?`<span class="badge">${t('aFalse')}</span>`:`<span class="badge bad">${t('aOpen')}</span>`;
    h+=`<div class="card alert ${a.status==='open'?'open':'done'}"><div class="top"><b>${k} ${t('abn')}</b>${res}</div><div class="mute">${pn} · ${clock(a.t)}</div><p style="margin:8px 0">${t('nv')} ${a.from.toFixed(2)} → ${a.to.toFixed(2)}${u} (${t('score')} ${a.score.toFixed(2)})</p><p class="mute" style="margin:0">${t('fixed')} ${TH} NTU: <b>${a.fixed?t('fyes'):t('fno')}</b></p>${a.status==='open'?`<div class="btns" style="margin-top:12px"><button class="btn" data-a="done" data-v="${a.uid}" data-r="confirmed">${t('aReal')}</button><button class="btn alt" data-a="done" data-v="${a.uid}" data-r="false">${t('aFalse')}</button></div>`:''}</div>`;
  });
  return h;
}
function fcHTML(){
  const id=pid('fc'),p=PTS.find(x=>x.id===id),v=S.data[id].map(r=>r.turb).slice(-40),f=forecast(id);
  const trend=f.slope>0.03?`<span class="warn">${t('up')}</span>`:f.slope<-0.03?`<span class="ok">${t('down')}</span>`:`<span class="ok">${t('flat')}</span>`;
  const eta=f.eta?t('etaY').replace('{0}',TH).replace('{1}',f.eta):t('etaN').replace('{0}',TH);
  return `<div class="card"><h2>${p.n}</h2>${chart(v,f.pred)}</div><div class="card"><div class="big">${trend}</div><p style="margin:4px 0">${eta}</p><p class="mute" style="margin:0">${t('mae')}: <b>${f.mae==null?'—':f.mae.toFixed(2)+' NTU'}</b> · ${t('demo')}</p></div>`;
}
function render(){
  const open=Object.values(S.open).filter(Boolean).length;
  $('dot').hidden=!open;$('dot').textContent=open;
  if(S.tab==='home')$('p-home').innerHTML=homeHTML();
  if(CATS[S.tab]){if(S.listFor!==S.tab||!$('rows')){$('p-list').innerHTML=listShell(S.tab);S.listFor=S.tab;}$('rows').innerHTML=rowsHTML(S.tab,$('q').value);}
  if(S.tab==='alerts')$('al').innerHTML=alertsHTML();
  if(S.tab==='fc')$('fcBody').innerHTML=fcHTML();
}
function init(){
  S.tick=0;S.data={};S.open={};S.calm={};S.boost={};S.mute={};S.z={};
  PTS.forEach(p=>{S.data[p.id]=[];for(let k=0;k<40;k++)S.data[p.id].push(gen(p.id,k));S.tick=40;});
}
function msg(t){$('msg').textContent=t;}
document.addEventListener('click',e=>{
  const b=e.target.closest('[data-a]');if(!b)return;
  const a=b.dataset.a,v=b.dataset.v;
  if(a==='tab'){S.tab=v;const sec=CATS[v]?'list':v;['home','list','alerts','fc','lab'].forEach(t=>{$('p-'+t).hidden=t!==sec;});document.querySelectorAll('nav button').forEach(n=>n.setAttribute('aria-current',n.dataset.v===v?'page':'false'));window.scrollTo(0,0);}
  if(a==='sel')S.sel=v;
  if(a==='done'){const al=S.alerts.find(x=>x.uid===v);if(al){al.status=b.dataset.r;S.open[al.id]=null;S.mute[al.id]=S.tick+8;save();}}
  if(a==='play'){S.play=!S.play;b.dataset.i=S.play?'pause':'resume';b.textContent=t(b.dataset.i);}
  if(a==='inj'){const q=pid('inj');S.boost[q]=10;S.mute[q]=0;b.textContent=t('injing');setTimeout(()=>{b.textContent=t('injB');},4000);}
  if(a==='add'){
    const id=pid('mp'),t=parseFloat($('mt').value),p=parseFloat($('mph').value),c=parseFloat($('mtemp').value);
    if([t,p,c].some(isNaN)||t<0||p<0||p>14){msg(t('m1'));return;}
    const before=S.alerts.length;addReading(id,{t:Date.now(),turb:t,ph:p,tp:c});
    msg(S.alerts.length>before?t('m2'):t('m3'));
  }
  if(a==='nt'){const ls=[...document.querySelectorAll('#ntLocs input:checked')].map(i=>i.value),imp=$('ntImp').value.trim(),when=new Date($('ntDt').value).getTime();
    if(!ls.length||!imp||isNaN(when)){$('ntMsg').textContent=t('e1');return;}
    if(when<Date.now()+7*864e5){$('ntMsg').textContent=t('e2');return;}
    N.unshift({uid:''+Date.now(),locs:ls,imp,when,at:Date.now()});saveN();$('ntMsg').textContent=t('saved');$('ntImp').value='';renderN();return;}
  if(a==='ntdel'){N=N.filter(n=>n.uid!==v);saveN();renderN();return;}
  if(a==='reset'){S.alerts=[];save();init();msg('');}
  render();
});
document.addEventListener('input',e=>{if(e.target.id==='q')render();});
document.addEventListener('change',e=>{const m=/^(\w+)Loc$/.exec(e.target.id);if(m){$(m[1]+'FlW').hidden=R.find(x=>x.n===e.target.value).c!=='dorm';}if(e.target.id==='lang'){S.lang=e.target.value;try{localStorage.setItem('aquacare.lang',S.lang)}catch(_){}applyLang();}render();});
S.alerts=load().filter(a=>PTS.some(p=>p.id===a.id));init();
S.alerts.forEach(a=>{if(a.status==='open')S.open[a.id]=a.uid;});
setup();applyLang();
setInterval(()=>{if(!S.play)return;S.tick++;PTS.forEach(p=>addReading(p.id,gen(p.id,S.tick)));render();},2000);
</script>
</body>
</html>
